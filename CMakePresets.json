{
	"version": 3,
	"cmakeMinimumRequired": {
		"major": 3,
		"minor": 21,
		"patch": 0
	},
	"configurePresets": [
		{
			"name": "base",
			"hidden": true,
			"binaryDir": "${sourceDir}/build/${presetName}",
			"installDir": "${sourceDir}/build/${presetName}/install"
		},
		{
			"name": "licensed",
			"hidden": true,
			"description": "The Release edition: no watermark (needs a license, https://oscar-soirey.github.io/Raven/license.html)",
			"cacheVariables": {
				"RAVEN_EDITION": "Release"
			}
		},
		{
			"name": "msvc",
			"displayName": "Visual C++ (the newest Visual Studio installed), static library",
			"inherits": "base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},
		{
			"name": "msvc-shared",
			"displayName": "Visual C++, raven.dll",
			"inherits": "msvc",
			"cacheVariables": {
				"RAVEN_BUILD_SHARED": "ON"
			}
		},
		{
			"name": "msvc-release",
			"displayName": "Visual C++, static library, Release edition (licensed, no watermark)",
			"inherits": ["licensed", "msvc"]
		},
		{
			"name": "msvc-shared-release",
			"displayName": "Visual C++, raven.dll, Release edition (licensed, no watermark)",
			"inherits": ["licensed", "msvc-shared"]
		},
		{
			"name": "mingw",
			"displayName": "MinGW-w64 (gcc), static library",
			"inherits": "base",
			"generator": "MinGW Makefiles",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release",
				"CMAKE_C_COMPILER": "gcc"
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},
		{
			"name": "mingw-shared",
			"displayName": "MinGW-w64 (gcc), raven.dll",
			"inherits": "mingw",
			"cacheVariables": {
				"RAVEN_BUILD_SHARED": "ON"
			}
		},
		{
			"name": "mingw-release",
			"displayName": "MinGW-w64 (gcc), static library, Release edition (licensed, no watermark)",
			"inherits": ["licensed", "mingw"]
		},
		{
			"name": "mingw-shared-release",
			"displayName": "MinGW-w64 (gcc), raven.dll, Release edition (licensed, no watermark)",
			"inherits": ["licensed", "mingw-shared"]
		},
		{
			"name": "linux",
			"displayName": "Linux, static library",
			"inherits": "base",
			"generator": "Unix Makefiles",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Release"
			},
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			}
		},
		{
			"name": "linux-shared",
			"displayName": "Linux, libraven.so",
			"inherits": "linux",
			"cacheVariables": {
				"RAVEN_BUILD_SHARED": "ON"
			}
		},
		{
			"name": "linux-release",
			"displayName": "Linux, static library, Release edition (licensed, no watermark)",
			"inherits": ["licensed", "linux"]
		},
		{
			"name": "linux-shared-release",
			"displayName": "Linux, libraven.so, Release edition (licensed, no watermark)",
			"inherits": ["licensed", "linux-shared"]
		},
		{
			"name": "dev",
			"displayName": "Debug, warnings as errors",
			"inherits": "base",
			"cacheVariables": {
				"CMAKE_BUILD_TYPE": "Debug",
				"RAVEN_WARNINGS_AS_ERRORS": "ON"
			}
		}
	],
	"buildPresets": [
		{
			"name": "msvc",
			"configurePreset": "msvc",
			"configuration": "Release"
		},
		{
			"name": "msvc-shared",
			"configurePreset": "msvc-shared",
			"configuration": "Release"
		},
		{
			"name": "msvc-release",
			"configurePreset": "msvc-release",
			"configuration": "Release"
		},
		{
			"name": "msvc-shared-release",
			"configurePreset": "msvc-shared-release",
			"configuration": "Release"
		},
		{
			"name": "mingw",
			"configurePreset": "mingw"
		},
		{
			"name": "mingw-shared",
			"configurePreset": "mingw-shared"
		},
		{
			"name": "mingw-release",
			"configurePreset": "mingw-release"
		},
		{
			"name": "mingw-shared-release",
			"configurePreset": "mingw-shared-release"
		},
		{
			"name": "linux",
			"configurePreset": "linux"
		},
		{
			"name": "linux-shared",
			"configurePreset": "linux-shared"
		},
		{
			"name": "linux-release",
			"configurePreset": "linux-release"
		},
		{
			"name": "linux-shared-release",
			"configurePreset": "linux-shared-release"
		},
		{
			"name": "dev",
			"configurePreset": "dev"
		}
	],
	"testPresets": [
		{
			"name": "msvc",
			"configurePreset": "msvc",
			"configuration": "Release",
			"output": {
				"outputOnFailure": true
			}
		},
		{
			"name": "mingw",
			"configurePreset": "mingw",
			"output": {
				"outputOnFailure": true
			}
		},
		{
			"name": "linux",
			"configurePreset": "linux",
			"output": {
				"outputOnFailure": true
			}
		},
		{
			"name": "linux-shared",
			"configurePreset": "linux-shared",
			"output": {
				"outputOnFailure": true
			}
		},
		{
			"name": "linux-release",
			"configurePreset": "linux-release",
			"output": {
				"outputOnFailure": true
			}
		},
		{
			"name": "dev",
			"configurePreset": "dev",
			"output": {
				"outputOnFailure": true
			}
		}
	]
}
