<?xml version="1.0" encoding="UTF-8"?>
<!--
  Raven example - browser

  <WebView> is not a tag of Raven: the optional library raven_web adds it
  (Rweb_register_xml). The page it shows is a real web page, drawn by a
  browser installed on the computer, and shown here like any picture: under
  the island of the window, next to the other widgets, in the theme or not.
-->
<Window Title="Raven - web" Width="1180" Height="760" MinWidth="720" MinHeight="460">
	<VBox>
		<HBox Spacing="8" Slot.Padding="10,8,10,8">
			<Button Name="back" Text="Back" Style="Flat" OnClicked="web.back"/>
			<Button Name="forward" Text="Forward" Style="Flat" OnClicked="web.forward"/>
			<Button Text="Reload" Style="Flat" OnClicked="web.reload"/>
			<Button Text="Home" Style="Flat" OnClicked="web.home"/>
			<TextInput Name="address" Placeholder="Address: https://..., or a file" OnCommitted="web.go" Slot.Fill="1"/>
			<Label Text="Zoom" Slot.VAlign="Center" Opacity="0.7"/>
			<Slider Name="zoom" Min="0.5" Max="2" Step="0.05" Value="1" Width="120" OnChanged="web.zoom" Slot.VAlign="Center"/>
		</HBox>
		<Separator/>
		<HBox Slot.Fill="1">
			<WebView Name="page" Source="pages/welcome.html" OnChanged="web.navigated" Slot.Fill="1"/>
			<Separator Orientation="Vertical"/>
			<VBox Width="290" Spacing="10" Slot.Padding="14">
				<Label Name="title" Text="" TextSize="17" Wrap="true"/>
				<Label Name="status" Text="" Opacity="0.6" Wrap="true"/>
				<Separator/>
				<Label Text="From Raven to the page" Opacity="0.6"/>
				<Label Markdown="true" Wrap="true">This color picker is a widget of Raven. It sets a **CSS variable** of the page with `Rweb_view_run_javascript`.</Label>
				<ColorPicker Name="tint" Color="#7C5CFF" Alpha="false" Compact="true" OnChanged="web.tint"/>
				<Separator/>
				<Label Text="From the page to Raven" Opacity="0.6"/>
				<Label Name="log" Wrap="true" Markdown="true">*Nothing yet: press a button of the page.*</Label>
			</VBox>
		</HBox>
	</VBox>
</Window>
