<!-- hello_rust: the interface and its Rust code, in one file. F5 builds and runs it. -->
<script>
use raven::*;
use std::sync::atomic::{AtomicI32, Ordering};

static CLICKS: AtomicI32 = AtomicI32::new(0);

/// OnClicked="{on_hello}" below calls this function: the compiler checks it
fn on_hello(_sender: Rid, _action: &str) {
    let clicks = CLICKS.fetch_add(1, Ordering::SeqCst) + 1;
    // ui().status: the widget with Name="status"
    unsafe { Rlabel_set_text(ui().status, Rtr_plural(cstr("clicks").as_ptr(), clicks)) };
}

fn main() {
    unsafe {
        if Rinit(R_BACKEND_VULKAN) == 0 {
            return;
        }
        Rlocale_load_csv(cstr("strings.csv").as_ptr());
        Rlocale_set_language(Rlocale_get_system_language());
    }
    main_create();
    unsafe {
        while Rdraw_frame() != 0 {}
        Rshutdown();
    }
}
</script>

<Window Title="hello_rust" Width="480" Height="320">
	<VBox Spacing="12" Slot.Padding="24">
		<Label Text="@hello.title" TextSize="24"/>
		<Label Name="status" Text="@hello.none" Opacity="0.7"/>
		<Button Text="@hello.button" Style="Primary" OnClicked="{on_hello}" Slot.HAlign="Left"/>
	</VBox>
</Window>
