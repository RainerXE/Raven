<!-- hello_csharp: the interface and its C# code, in one file. F5 builds and runs it. -->
<script>
using Raven;

public static partial class MainUi
{
    static int clicks;

    // OnClicked="{OnHello}" below calls this method: the compiler checks it
    static void OnHello(uint sender, string action)
    {
        clicks++;
        // status: the widget with Name="status"
        R.Rlabel_set_text(status, R.Rtr_plural("clicks", clicks));
    }
}

public static class Program
{
    public static int Main()
    {
        if (R.Rinit(RBackend.R_BACKEND_VULKAN) == 0) return 1;
        R.Rlocale_load_csv("strings.csv");
        R.Rlocale_set_language(R.Rlocale_get_system_language());
        MainUi.Create();
        while (R.Rdraw_frame() != 0) { }
        R.Rshutdown();
        return 0;
    }
}
</script>

<Window Title="hello_csharp" Width="480" Height="320">
	<VBox Spacing="12" Slot.Padding="24">
		<Label Text="@hello.title" TextSize="24"/>
		<Label Name="status" Text="@hello.none" Opacity="0.7"/>
		<Button Text="@hello.button" Style="Primary" OnClicked="{OnHello}" Slot.HAlign="Left"/>
	</VBox>
</Window>
