<!-- hello_cpp: the interface and its C++ code, in one file. F5 builds and runs it. -->
<script>
#include <string>

static int g_clicks = 0;

// OnClicked="{on_hello}" below calls this function: the compiler checks it
static void on_hello(Rid sender, const char* action) {
	(void)sender;
	(void)action;
	g_clicks++;
	// ui.status: the widget with Name="status"
	Rlabel_set_text(ui.status, Rtr_plural("clicks", g_clicks));
}

int main() {
	if (!Rinit(R_BACKEND_VULKAN)) return 1;
	Rlocale_load_csv("strings.csv");
	Rlocale_set_language(Rlocale_get_system_language());
	main_create();
	while (Rdraw_frame()) {}
	Rshutdown();
	return 0;
}
</script>

<Window Title="hello_cpp" Width="480" Height="320">
	<VBox Spacing="12" Slot.Padding="24">
		<Label Text="@hello.title" TextSize="24"/>
		<Label Name="status" Text="@hello.none" Opacity="0.7"/>
		<Button Text="@hello.button" Style="Primary" OnClicked="{on_hello}" Slot.HAlign="Left"/>
	</VBox>
</Window>
