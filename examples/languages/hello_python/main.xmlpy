<!-- hello_python: the interface and its Python code, in one file. F5 runs it. -->
<script>
import sys
import raven as r

clicks = 0


# OnClicked="{on_hello}" below calls this function
def on_hello(sender, action):
    global clicks
    clicks += 1
    # ui.status: the widget with Name="status"
    r.Rlabel_set_text(ui.status, r.Rtr_plural("clicks", clicks))


if __name__ == "__main__":
    if not r.Rinit(r.R_BACKEND_VULKAN):
        sys.exit(1)
    r.Rlocale_load_csv("strings.csv")
    r.Rlocale_set_language(r.Rlocale_get_system_language())
    main_create()
    while r.Rdraw_frame():
        pass
    r.Rshutdown()
</script>

<Window Title="hello_python" Width="480" Height="320">
	<VBox Spacing="12" Slot.Padding="24">
		<Label Text="@hello.title" TextSize="24"/>
		<Label Name="status" Text="@hello.none" Opacity="0.7"/>
		<Button Text="@hello.button" Style="Primary" OnClicked="{on_hello}" Slot.HAlign="Left"/>
	</VBox>
</Window>
