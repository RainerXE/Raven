<!-- hello_lua: the interface and its Lua code (LuaJIT), in one file. F5 runs it. -->
<script>
local r = require("raven")

clicks = 0

-- OnClicked="{on_hello}" below calls this function (a global function)
function on_hello(sender, action)
	clicks = clicks + 1
	-- ui.status: the widget with Name="status"
	r.Rlabel_set_text(ui.status, r.Rtr_plural("clicks", clicks))
end

if r.Rinit(r.R_BACKEND_VULKAN) == 0 then os.exit(1) end
r.Rlocale_load_csv("strings.csv")
r.Rlocale_set_language(r.Rlocale_get_system_language())
main_create()
while r.Rdraw_frame() ~= 0 do end
r.Rshutdown()
</script>

<Window Title="hello_lua" Width="480" Height="320">
	<VBox Spacing="12" Slot.Padding="24">
		<Label Text="@hello.title" TextSize="24"/>
		<Label Name="status" Text="@hello.none" Opacity="0.7"/>
		<Button Text="@hello.button" Style="Primary" OnClicked="{on_hello}" Slot.HAlign="Left"/>
	</VBox>
</Window>
