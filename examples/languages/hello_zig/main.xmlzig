<!-- hello_zig: the interface and its Zig code, in one file. F5 builds and runs it. -->
<script>
const r = @import("raven");

var clicks: c_int = 0;

// OnClicked="{on_hello}" below calls this function: the compiler checks it
fn on_hello(sender: r.Rid, action: ?[*:0]const u8, user_data: ?*anyopaque) callconv(.C) void {
    _ = sender;
    _ = action;
    _ = user_data;
    clicks += 1;
    // ui.status: the widget with Name="status"
    r.Rlabel_set_text(ui.status, r.Rtr_plural("clicks", clicks));
}

pub fn main() void {
    if (r.Rinit(r.R_BACKEND_VULKAN) == 0) return;
    _ = r.Rlocale_load_csv("strings.csv");
    _ = r.Rlocale_set_language(r.Rlocale_get_system_language());
    _ = main_create();
    while (r.Rdraw_frame() != 0) {}
    r.Rshutdown();
}
</script>

<Window Title="hello_zig" Width="480" Height="320">
	<VBox Spacing="12" Slot.Padding="24">
		<Label Text="@hello.title" TextSize="24"/>
		<Label Name="status" Text="@hello.none" Opacity="0.7"/>
		<Button Text="@hello.button" Style="Primary" OnClicked="{on_hello}" Slot.HAlign="Left"/>
	</VBox>
</Window>
