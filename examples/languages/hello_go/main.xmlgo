<!-- hello_go: the interface and its Go code, in one file. F5 builds and runs it. -->
<script>
package main

import "raven/raven"

var clicks = 0

// OnClicked="{on_hello}" below calls this function: the compiler checks it
func on_hello(sender raven.ID, action string) {
	clicks++
	// ui.status: the widget with Name="status"
	raven.LabelSetText(ui.status, raven.TrPlural("clicks", clicks))
}

func main() {
	if raven.Init(raven.R_BACKEND_VULKAN) == 0 {
		return
	}
	raven.LocaleLoadCsv("strings.csv")
	raven.LocaleSetLanguage(raven.LocaleGetSystemLanguage())
	main_create()
	for raven.DrawFrame() != 0 {
	}
	raven.Shutdown()
}
</script>

<Window Title="hello_go" Width="480" Height="320">
	<VBox Spacing="12" Slot.Padding="24">
		<Label Text="@hello.title" TextSize="24"/>
		<Label Name="status" Text="@hello.none" Opacity="0.7"/>
		<Button Text="@hello.button" Style="Primary" OnClicked="{on_hello}" Slot.HAlign="Left"/>
	</VBox>
</Window>
