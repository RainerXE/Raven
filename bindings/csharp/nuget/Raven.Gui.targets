<!--
  Imported by NuGet into every project that uses the Raven.Gui package.

  The .xmlcs files of the project (an interface in Raven XML with its C# code)
  are compiled with the ravenc of the package, unless RavenC (or the RAVENC
  environment variable) names another one.
-->
<Project>
  <PropertyGroup>
    <_RavenGuiTools>$(MSBuildThisFileDirectory)../tools/</_RavenGuiTools>
    <_RavenGuiRavenC Condition="$([MSBuild]::IsOSPlatform('Windows'))">$(_RavenGuiTools)win-x64/ravenc.exe</_RavenGuiRavenC>
    <_RavenGuiRavenC Condition="$([MSBuild]::IsOSPlatform('Linux'))">$(_RavenGuiTools)linux-x64/ravenc</_RavenGuiRavenC>
    <_RavenGuiRavenC Condition="$([MSBuild]::IsOSPlatform('OSX'))">$(_RavenGuiTools)osx/ravenc</_RavenGuiRavenC>
    <RavenC Condition="'$(RavenC)' == '' and '$(RAVENC)' == '' and '$(_RavenGuiRavenC)' != '' and Exists('$(_RavenGuiRavenC)')">$(_RavenGuiRavenC)</RavenC>
  </PropertyGroup>

  <!-- NuGet does not keep the execute permission of the files it extracts -->
  <Target Name="RavenGuiMakeRavenCExecutable" BeforeTargets="RavenCompileXmlCs"
          Condition="'$(OS)' != 'Windows_NT' and '@(XmlCs)' != '' and '$(RavenC)' == '$(_RavenGuiRavenC)'">
    <Exec Command="chmod +x &quot;$(RavenC)&quot;" ContinueOnError="true" />
  </Target>

  <Import Project="$(MSBuildThisFileDirectory)Raven.XmlCs.targets" />
</Project>
