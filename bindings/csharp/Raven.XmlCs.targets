<!--
  Raven for C#: the .xmlcs files of a project (an interface in Raven XML with
  its C# code) compiled by ravenc before the C# compiler runs.

    <Import Project="path/to/bindings/csharp/Raven.XmlCs.targets" />

  Every .xmlcs of the project is compiled into obj/.../NAME.xmlcs.cs (again
  when it changes). The scripts keep their lines: the errors of the compiler
  point into the .xmlcs. RavenC is the ravenc program (default: ravenc, in
  the PATH): /p:RavenC=C:\Raven\bin\ravenc.exe
-->
<Project>
  <PropertyGroup>
    <RavenC Condition="'$(RavenC)' == '' and '$(RAVENC)' != ''">$(RAVENC)</RavenC>
    <RavenC Condition="'$(RavenC)' == ''">ravenc</RavenC>
  </PropertyGroup>

  <ItemGroup>
    <XmlCs Include="**/*.xmlcs" Exclude="$(DefaultItemExcludes);$(DefaultExcludesInProjectFolder)" />
    <None Remove="**/*.xmlcs" />
    <None Include="@(XmlCs)" />
  </ItemGroup>

  <Target Name="RavenCompileXmlCs" BeforeTargets="CoreCompile" Inputs="@(XmlCs)" Outputs="@(XmlCs->'$(IntermediateOutputPath)%(Filename).xmlcs.cs')">
    <MakeDir Directories="$(IntermediateOutputPath)" />
    <Exec Command="&quot;$(RavenC)&quot; &quot;%(XmlCs.FullPath)&quot; -o &quot;$(IntermediateOutputPath)%(XmlCs.Filename).xmlcs.cs&quot; --lang csharp" />
  </Target>

  <Target Name="RavenAddXmlCs" BeforeTargets="CoreCompile" AfterTargets="RavenCompileXmlCs">
    <ItemGroup>
      <Compile Include="@(XmlCs->'$(IntermediateOutputPath)%(Filename).xmlcs.cs')" />
      <FileWrites Include="@(XmlCs->'$(IntermediateOutputPath)%(Filename).xmlcs.cs')" />
    </ItemGroup>
  </Target>
</Project>
