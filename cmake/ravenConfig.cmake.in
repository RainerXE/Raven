@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(NOT WIN32)
	set(THREADS_PREFER_PTHREAD_FLAG ON)
	find_dependency(Threads)
endif()

include("${CMAKE_CURRENT_LIST_DIR}/ravenTargets.cmake")

# XMLC: raven_target_xmlc(<target>) compiles the .xmlc files of a target with ravenc
set(RAVEN_RAVENC "@PACKAGE_RAVEN_CONFIG_BINDIR@/ravenc")
if(CMAKE_HOST_WIN32)
	string(APPEND RAVEN_RAVENC ".exe")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/RavenXMLC.cmake")

# ---------------------------------------------------------------------------
#  Edition
#
#  A Raven package holds one edition: the free one (every window shows a
#  small watermark) or the paid one (no watermark). RAVEN_PAID says which.
# ---------------------------------------------------------------------------

set(RAVEN_PAID @RAVEN_PAID@)
if(NOT RAVEN_FIND_QUIETLY)
	if(RAVEN_PAID)
		message(STATUS "Raven: paid edition (no watermark)")
	else()
		message(STATUS "Raven: free edition (every window shows a watermark)")
	endif()
endif()

check_required_components(raven)
