<!--
	Raven - tests/test_xmlcpp.xmlc++
	The interface and its C++ in one file, compiled by ravenc: a function
	void(Rid, const char*) and a lambda in {}, ui.<Name>.
-->
<script>
#include "test.h"
#include <string>

static int g_clicks = 0;
static void on_ok(Rid sender, const char* action) {
	(void)action;
	CHECK(sender == ui.ok);
	g_clicks++;
	std::string text = "Clicked " + std::to_string(g_clicks);
	Rlabel_set_text(ui.status, text.c_str());
}
static auto on_other = [](Rid, const char*) { g_clicks += 100; };
</script>

<Window Title="XMLC++" Width="400" Height="200">
	<VBox>
		<Label Name="status">Not clicked</Label>
		<Button Name="ok" Text="OK" OnClicked="{on_ok}"/>
		<Button Name="other" Text="Other" OnClicked="{on_other}"/>
	</VBox>
</Window>

<script>
int main() {
	Rid window;
	if (!test_init(0)) return 1;
	window = test_xmlcpp_create();
	Rdraw_frame();
	test_click(window, ui.ok);
	Rdraw_frame();
	CHECK(g_clicks == 1);
	CHECK_STR(Rlabel_get_text(ui.status), "Clicked 1");
	test_click(window, ui.other);
	Rdraw_frame();
	CHECK(g_clicks == 101);
	Rwindow_destroy(window);
	Rshutdown();
	return test_report("test_xmlcpp");
}
</script>
