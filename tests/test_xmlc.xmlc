<!--
	Raven - tests/test_xmlc.xmlc
	An interface and its C in one file, compiled by ravenc (no XML read at run time):
	{functions} in the events, ui.<Name>, the special children (<Item>), the expansions (<Repeat>).
-->
<script>
#include "test.h"

static int g_clicks = 0;
static void on_ok(Rid sender, const char* action, void* user_data) {
	(void)action; (void)user_data;
	CHECK(sender == ui.ok);
	g_clicks++;
	Rlabel_set_text(ui.status, "Clicked");
}
</script>

<Window Title="XMLC &amp; C" Width="400" Height="300">
	<VBox Name="box">
		<Label Name="status">Not clicked</Label>
		<Button Name="ok" Text="OK" OnClicked="{on_ok}"/>
		<ComboBox Name="combo"><Item>One</Item><Item>Two</Item></ComboBox>
		<Repeat Count="3"><Label Text="row"/></Repeat>
	</VBox>
</Window>

<script>
int main(void) {
	Rid window;
	if (!test_init(0)) {
		printf("test_xmlc: cannot initialize Raven\n");
		return 1;
	}
	window = test_xmlc_create();
	CHECK(Rwindow_is_valid(window));
	Rdraw_frame();
	CHECK_STR(Rlabel_get_text(ui.status), "Not clicked");
	CHECK(Rwidget_get_child_count(ui.box) == 6);
	CHECK(Rcombo_box_get_item_count(ui.combo) == 2);
	test_click(window, ui.ok);
	Rdraw_frame();
	CHECK(g_clicks == 1);
	CHECK_STR(Rlabel_get_text(ui.status), "Clicked");
	Rwindow_destroy(window);
	Rshutdown();
	return test_report("test_xmlc");
}
</script>
